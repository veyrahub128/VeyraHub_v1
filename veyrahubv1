--==================================================
-- DRAG DU MAIN FRAME
--==================================================

local function updateDrag(input)
    local delta = input.Position - dragStart

    MainFrame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updateDrag(input)
    end
end)

--==================================================
-- DRAG DU BOUTON FLOTTANT
--==================================================

local floatingDragging = false
local floatingDragStart
local floatingStartPos

ShowButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        floatingDragging = true
        floatingDragStart = input.Position
        floatingStartPos = ShowButton.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                floatingDragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if floatingDragging and
        (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then

        local delta = input.Position - floatingDragStart

        ShowButton.Position = UDim2.new(
            floatingStartPos.X.Scale,
            floatingStartPos.X.Offset + delta.X,
            floatingStartPos.Y.Scale,
            floatingStartPos.Y.Offset + delta.Y
        )
    end
end)

--==================================================
-- SHOW / HIDE
--==================================================

local function HideHub()
    HubVisible = false
    MainFrame.Visible = false
    ShowButton.Visible = true
end

local function ShowHub()
    HubVisible = true
    MainFrame.Visible = true
    ShowButton.Visible = false
end

HideButton.MouseButton1Click:Connect(HideHub)

ShowButton.MouseButton1Click:Connect(function()
    if not floatingDragging then
        ShowHub()
    end
end)

--==================================================
-- ADMIN CHECK
--==================================================

local function CheckAdmins()
    for _, player in ipairs(Players:GetPlayers()) do
        if Admins[player.Name] then
            LocalPlayer:Kick("Admin detected! Disconnecting...")
            return
        end
    end
end

--==================================================
-- TOGGLE HUB
--==================================================

local AdminConnection

local function ToggleHub()
    HubEnabled = not HubEnabled

    if HubEnabled then
        ToggleButton.Text = "ON"
        ToggleButton.TextColor3 = Color3.fromRGB(80, 255, 80)
        ToggleButton.BackgroundColor3 = Color3.fromRGB(25, 50, 35)

        StatusText.Text = "Enabled"
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 130)

        CheckAdmins()

        if AdminConnection then
            AdminConnection:Disconnect()
        end

        AdminConnection = RunService.Heartbeat:Connect(function()
            if HubEnabled then
                CheckAdmins()
            end
        end)

    else
        ToggleButton.Text = "OFF"
        ToggleButton.TextColor3 = Color3.fromRGB(255, 80, 80)
        ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 45)

        StatusText.Text = "Disabled"
        StatusText.TextColor3 = Color3.fromRGB(180, 180, 180)

        if AdminConnection then
            AdminConnection:Disconnect()
            AdminConnection = nil
        end
    end
end

ToggleButton.MouseButton1Click:Connect(ToggleHub)

--==================================================
-- CLAVIER H
--==================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == Enum.KeyCode.H then
        if HubVisible then
            HideHub()
        else
            ShowHub()
        end
    end
end)

