--------------------------------------------------
-- DRAG DU HUB
--------------------------------------------------

local hubDragging = false
local hubDragStart
local hubStartPosition

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        hubDragging = true
        hubDragStart = input.Position
        hubStartPosition = MainFrame.Position
    end
end)

TitleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        hubDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not hubDragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - hubDragStart

        MainFrame.Position = UDim2.new(
            hubStartPosition.X.Scale,
            hubStartPosition.X.Offset + delta.X,
            hubStartPosition.Y.Scale,
            hubStartPosition.Y.Offset + delta.Y
        )
    end
end)

--------------------------------------------------
-- DRAG DU V
--------------------------------------------------

local vDragging = false
local vDragStart
local vStartPosition
local vMoved = false

ShowButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        vDragging = true
        vMoved = false
        vDragStart = input.Position
        vStartPosition = ShowButton.Position
    end
end)

ShowButton.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        vDragging = false

        if not vMoved then
            HubVisible = true
            MainFrame.Visible = true
            ShowButton.Visible = false
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not vDragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - vDragStart

        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            vMoved = true
        end

        ShowButton.Position = UDim2.new(
            vStartPosition.X.Scale,
            vStartPosition.X.Offset + delta.X,
            vStartPosition.Y.Scale,
            vStartPosition.Y.Offset + delta.Y
        )
    end
end)

--------------------------------------------------
-- SHOW / HIDE
--------------------------------------------------

local function HideHub()
    HubVisible = false
    MainFrame.Visible = false
    ShowButton.Visible = true
end

local function ShowHub()
    HubVisible = true
    MainFrame.Visible = true
    ShowButton.Visible = false
end

HideButton.MouseButton1Click:Connect(function()
    HideHub()
end)

--------------------------------------------------
-- ADMIN CHECK
--------------------------------------------------

local function IsAdmin(player)
    if not player then
        return false
    end

    return Admins[player.Name] == true
end

local function CheckPlayer(player)
    if not HubEnabled then
        return
    end

    if IsAdmin(player) then
        LocalPlayer:Kick("Admin detected! Disconnecting...")
    end
end

local function CheckAdmins()
    if not HubEnabled then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if IsAdmin(player) then
            LocalPlayer:Kick("Admin detected! Disconnecting...")
            return
        end
    end
end

--------------------------------------------------
-- DETECTION DES NOUVEAUX JOUEURS
--------------------------------------------------

Players.PlayerAdded:Connect(function(player)
    if not HubEnabled then
        return
    end

    task.defer(function()
        CheckPlayer(player)
    end)
end)

--------------------------------------------------
-- TOGGLE
--------------------------------------------------

local function ToggleHub()
    HubEnabled = not HubEnabled

    if HubEnabled then

        ToggleButton.Text = "ON"
        ToggleButton.TextColor3 = Color3.fromRGB(80, 255, 80)
        ToggleButton.BackgroundColor3 = Color3.fromRGB(25, 50, 35)

        StatusText.Text = "Enabled"
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 130)

        -- Vérification immédiate des joueurs présents
        CheckAdmins()

    else

        ToggleButton.Text = "OFF"
        ToggleButton.TextColor3 = Color3.fromRGB(255, 80, 80)
        ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 45)

        StatusText.Text = "Disabled"
        StatusText.TextColor3 = Color3.fromRGB(180, 180, 180)

    end
end

ToggleButton.MouseButton1Click:Connect(function()
    ToggleHub()
end)

--------------------------------------------------
-- TOUCHE H
--------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gameProcessed)

    if gameProcessed then
        return
    end

    if input.KeyCode == Enum.KeyCode.H then

        if HubVisible then
            HideHub()
        else
            ShowHub()
        end

    end
end)

